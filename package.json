{
  "name": "@ilyasemenov/eslint-config",
  "type": "module",
  "version": "1.5.3",
  "packageManager": "bun@1.4.4",
  "description": "Opinionated ESLint config on top of @antfu/eslint-config",
  "author": "Ilya Semenov",
  "license": "MIT",
  "homepage": "https://github.com/IlyaSemenov/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/eslint-config.git"
  },
  "bugs": "https://github.com/IlyaSemenov/eslint-config/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "lint": "eslint --fix .",
    "test": "bun test",
    "types": "bun check"
  },
  "peerDependencies": {
    "eslint": "^9.5.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "~7.4.3",
    "eslint-plugin-perfectionist": "^5.3.1",
    "eslint-plugin-vue": "^10.9.0",
    "eslint-plugin-vue-pug": "^1.0.0-alpha.6"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typescript": "~6.0.3"
  }
}
